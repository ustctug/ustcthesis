\ProvidesFile{ustcthesis-authoryear.cbx}[2025-07-01 v5.0.0 GB/T 7714 author-year citation style (USTC variant)]

\RequireCitationStyle{authoryear-comp}

\newtoggle{cbx:punctfull}
\toggletrue{cbx:punctfull}
\DeclareBibliographyOption[string]{citepunct}{%
  \ifcsdef{blx@opt@cite@punct@#1}
    {\csuse{blx@opt@cite@punct@#1}}
    {\blx@err@invopt{citepunct=#1}{}}}

\def\blx@opt@cite@punct@full{\toggletrue{cbx:punctfull}}
\def\blx@opt@cite@punct@half{\togglefalse{cbx:punctfull}}

\ExecuteBibliographyOptions{
  maxcitenames = 1,
  mincitenames = 1,
  parentracker = false,
}

\newcommand*{\bibciteleftparen}{\blx@postpunct\iftoggle{cbx:punctfull}{（}{(}}
\newcommand*{\bibciterightparen}{\blx@postpunct\iftoggle{cbx:punctfull}{）}{)}\midsentence}

\protected\def\bibciteopenparen{\bibciteleftparen}%
\protected\def\bibcitecloseparen{\bibciterightparen}%

\renewcommand*{\multicitedelim}{\addcomma\space}

\DeclareDelimFormat{prenotedelim}{\iftoggle{cbx:punctfull}{}{\addspace}}

\DeclareDelimFormat{nameyeardelim}{\addcitecomma}
\DeclareDelimFormat[textcite]{nameyeardelim}{\iftoggle{cbx:punctfull}{}{\addspace}}
\DeclareDelimFormat{nonameyeardelim}{\addcitecomma}
\DeclareDelimFormat[textcite]{nonameyeardelim}{\iftoggle{cbx:punctfull}{}{\addspace}}

\newrobustcmd*{\addcitecomma}{\iftoggle{cbx:punctfull}{\addfullcomma}{\addcomma\space}}

\DeclareFieldFormat{postnote}{\mkautorange{#1}}

\DeclareFieldFormat{superscript}{\mkbibsuperscript{#1}}

\renewbibmacro*{prenote}{%
  \iffieldundef{prenote}
    {}
    {\printfield{prenote}%
     \setunit{\printdelim{prenotedelim}}}}

\renewbibmacro*{postnote}{%
  \iffieldundef{postnote}
    {}
    % {\setunit{\printdelim{postnotedelim}}%
    {\setunit{}%
     \printfield{postnote}}}


\renewbibmacro*{textcite}{%
  \iffieldequals{namehash}{\cbx@lasthash}
    {\iffieldundef{shorthand}
       {\ifboolexpr{test {\iffieldequals{labelyear}{\cbx@lastyear}}
                    and (test {\ifnumequal{\value{multicitecount}}{0}}
                         or test {\iffieldundef{postnote}})}
          {\setunit{\addcomma}%
           \usebibmacro{cite:extradate}}
          {\setunit{\compcitedelim}%
           \usebibmacro{cite:labeldate+extradate}%
           \savefield{labelyear}{\cbx@lastyear}}}
       {\setunit{\compcitedelim}%
        \usebibmacro{cite:shorthand}%
        \global\undef\cbx@lastyear}}
    {\ifnameundef{labelname}
       {\iffieldundef{shorthand}
          {\usebibmacro{cite:label}%
           \setunit{%
             \global\booltrue{cbx:parens}%
             % \printdelim{nonameyeardelim}\bibopenparen}%
             \printdelim{nonameyeardelim}\bibciteopenparen}%
           \ifnumequal{\value{citecount}}{1}
             {\usebibmacro{prenote}}
             {}%
           \usebibmacro{cite:labeldate+extradate}}
          {\usebibmacro{cite:shorthand}}}
       {\printnames{labelname}%
        \setunit{%
          \global\booltrue{cbx:parens}%
          % \printdelim{nameyeardelim}\bibopenparen}%
          \printdelim{nameyeardelim}\bibciteopenparen}%
        \ifnumequal{\value{citecount}}{1}
          {\usebibmacro{prenote}}
          {}%
        \iffieldundef{shorthand}
          {\iffieldundef{labelyear}
             {\usebibmacro{cite:label}}
             {\usebibmacro{cite:labeldate+extradate}}%
           \savefield{labelyear}{\cbx@lastyear}}
          {\usebibmacro{cite:shorthand}%
           \global\undef\cbx@lastyear}}%
     \stepcounter{textcitecount}%
     \savefield{namehash}{\cbx@lasthash}}%
  \setunit{%
    \ifbool{cbx:parens}
      % {\bibcloseparen\global\boolfalse{cbx:parens}}
      {\bibcitecloseparen\global\boolfalse{cbx:parens}}
      {}%
    \textcitedelim}}

\renewbibmacro*{textcite:postnote}{%
  \setunit{}%
  \printtext{%
    \ifbool{cbx:parens}
      {\bibcitecloseparen\global\boolfalse{cbx:parens}}
      {}}%
  % \usebibmacro{postnote}%
  \iffieldundef{postnote}
    {}
    {\printtext[superscript]{\usebibmacro{postnote}}}}
  % \ifnumequal{\value{multicitecount}}{\value{multicitetotal}}
  %   {\setunit{}%
  %    \printtext{%
  %      \ifbool{cbx:parens}
  %        {\bibcloseparen\global\boolfalse{cbx:parens}}
  %        {}}}
  %   {\setunit{%
  %      \ifbool{cbx:parens}
  %        {\bibcloseparen\global\boolfalse{cbx:parens}}
  %        {}%
  %      \textcitedelim}}}

\DeclareCiteCommand{\parencite}%[\mkbibparens]
  % {\usebibmacro{cite:init}%
  {\printtext{\bibciteopenparen}\usebibmacro{cite:init}%
   \usebibmacro{prenote}}
  {\usebibmacro{citeindex}%
   \usebibmacro{cite}}
  {}
  % {\usebibmacro{postnote}}
  {\setunit{}\printtext{\bibcitecloseparen}%
   \iffieldundef{postnote}
     {}
     {\printtext[superscript]{\usebibmacro{postnote}}}}

\DeclareCiteCommand*{\parencite}%[\mkbibparens]
  % {\usebibmacro{cite:init}%
  {\printtext{\bibciteopenparen}\usebibmacro{cite:init}%
   \usebibmacro{prenote}}
  {\usebibmacro{citeindex}%
   \usebibmacro{citeyear}}
  {}
  % {\usebibmacro{postnote}}
  {\setunit{}\printtext{\bibcitecloseparen}%
   \iffieldundef{postnote}
     {}
     {\printtext[superscript]{\usebibmacro{postnote}}}}

\providerobustcmd*{\citet}{%
  \@ifstar
    {\AtNextCite{\AtEachCitekey{\defcounter{maxnames}{999}}}%
     \textcite}
    {\textcite}}

\providerobustcmd*{\citep}{%
  \@ifstar
    {\AtNextCite{\AtEachCitekey{\defcounter{maxnames}{999}}}%
     \parencite}
    {\parencite}}
