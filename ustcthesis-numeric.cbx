\ProvidesFile{ustcthesis-numeric.cbx}[2025-07-01 v5.0.0 GB/T 7714 numeric citation style (USTC variant)]

\RequireCitationStyle{numeric-comp}

\newbool{cbx:superscript}
\booltrue{cbx:superscript}

\DeclareBibliographyOption[boolean]{inline}[true]{%
  \ifstrequal{#1}{true}
    {\boolfalse{cbx:superscript}%
     \letcs\autocite{blx@acite@inline}%
     \letcs\autocites{blx@macite@inline}%
     \letcs\cite{blx@acite@inline}%
     \letcs\cites{blx@macite@inline}}
    {\booltrue{cbx:superscript}%
     \letcs\autocite{blx@acite@superscript}%
     \letcs\autocites{blx@macite@superscript}%
     \letcs\cite{blx@acite@superscript}%
     \letcs\cites{blx@macite@superscript}}}


\ExecuteBibliographyOptions{
  autocite     = superscript,
  maxcitenames = 1,
  mincitenames = 1,
  parentracker = false,
}


\DeclareFieldFormat{postnote}{\mkautorange{#1}}

\DeclareFieldFormat{superscript}{\mkbibsuperscript{#1}}
\DeclareFieldFormat{textcitesuperscript}{%
  \ifbool{cbx:superscript}
    {\mkbibsuperscript{#1}}
    {#1}}

\renewbibmacro*{prenote}{%
  \iffieldundef{prenote}
    {}
    {\printfield{prenote}%
     \setunit{\printdelim{prenotedelim}}}}

\renewbibmacro*{postnote}{%
  \iffieldundef{postnote}
    {}
    % {\setunit{\printdelim{postnotedelim}}%
    {\setunit{}%
     \printfield{postnote}}}

\renewbibmacro*{cite:dump}{%
  \usebibmacro{cite:dump:inset}%
  % dump labelnumber (+labelprefix)
  \ifnumgreater{\value{cbx@tempcnta}}{0}
    % {\ifnumgreater{\value{cbx@tempcnta}}{1}
    {\ifnumgreater{\value{cbx@tempcnta}}{0}
       {\setunit{\multiciterangedelim}}
       {\setunit{\multicitedelim}}%
     \usebibmacro{cite:print:last:labelnumber}%
     \global\undef\cbx@lastprefix}
    {}%
  \setcounter{cbx@tempcnta}{0}%
}

\DeclareCiteCommand{\cite}[\mkbibsuperscript]
  % {\usebibmacro{cite:init}%
  {\printtext{\bibopenbracket}\usebibmacro{cite:init}%
   \let\multicitedelim=\supercitedelim
   \let\multicitesubentrydelim=\supercitesubentrydelim
   \let\multiciterangedelim=\superciterangedelim
   \let\multicitesubentryrangedelim=\supercitesubentryrangedelim
   \iffieldundef{prenote}
     {}
     {\BibliographyWarning{Ignoring prenote argument}}%
   % \iffieldundef{postnote}
   %   {}
   %   {\BibliographyWarning{Ignoring postnote argument}}}
  }
  {\usebibmacro{citeindex}%
   \usebibmacro{cite:comp}}
  {}
  % {\usebibmacro{cite:dump}}
  {\usebibmacro{cite:dump}%
   \printtext{\bibclosebracket}%
   \usebibmacro{postnote}}

\DeclareCiteCommand{\parencite}%[\mkbibbrackets]
  % {\usebibmacro{cite:init}%
  {\printtext{\bibopenbracket}\usebibmacro{cite:init}%
   \usebibmacro{prenote}}
  {\usebibmacro{citeindex}%
   \usebibmacro{cite:comp}}
  {}
  {\usebibmacro{cite:dump}%
   % \usebibmacro{postnote}}
   \printtext{\bibclosebracket}%
   \iffieldundef{postnote}
     {}
     {\printtext[superscript]{\usebibmacro{postnote}}}}

\renewbibmacro*{textcite}{%
  \iffieldequals{namehash}{\cbx@lasthash}
    % {\usebibmacro{cite:comp}}
    {\printtext[textcitesuperscript]{\usebibmacro{cite:comp}}}
    {\usebibmacro{cite:dump}%
     \ifbool{cbx:parens}
       % {\printtext{\bibclosebracket}\global\boolfalse{cbx:parens}}
       % 使用上标
       {\printtext[textcitesuperscript]{\bibclosebracket}\global\boolfalse{cbx:parens}}
       {}%
     \iffirstcitekey
       {}
       {\setunit{\textcitedelim}}%
     \usebibmacro{cite:init}%
     \ifnameundef{labelname}
       {\printfield[citetitle]{labeltitle}}
       {\printnames{labelname}}%
     \setunit*{\printdelim{namelabeldelim}}%
     % \printtext{\bibopenbracket}\global\booltrue{cbx:parens}%
     % \ifnumequal{\value{citecount}}{1}
     %   {\usebibmacro{prenote}}
     %   {}%
     % \usebibmacro{cite:comp}%
     %
     % 使用上标
     \printtext[textcitesuperscript]{\bibopenbracket\global\booltrue{cbx:parens}%
       \ifnumequal{\value{citecount}}{1}
         {\usebibmacro{prenote}}
         {}%
       \usebibmacro{cite:comp}}%
     \stepcounter{textcitecount}%
     \savefield{namehash}{\cbx@lasthash}}}

\DeclareCiteCommand{\supercite}[\mkbibsuperscript]
  % {\usebibmacro{cite:init}%
  {\printtext{\bibopenbracket}\usebibmacro{cite:init}%
   \let\multicitedelim=\supercitedelim
   \let\multicitesubentrydelim=\supercitesubentrydelim
   \let\multiciterangedelim=\superciterangedelim
   \let\multicitesubentryrangedelim=\supercitesubentryrangedelim
   \iffieldundef{prenote}
     {}
     {\BibliographyWarning{Ignoring prenote argument}}%
   % \iffieldundef{postnote}
   %   {}
   %   {\BibliographyWarning{Ignoring postnote argument}}}
  }
  {\usebibmacro{citeindex}%
   \usebibmacro{cite:comp}}
  {}
  % {\usebibmacro{cite:dump}}
  {\usebibmacro{cite:dump}%
   \printtext{\bibclosebracket}%
   \usebibmacro{postnote}}

\DeclareCiteCommand{\cbx@textcite}
  {\usebibmacro{cite:init}}
  {\usebibmacro{citeindex}%
   \usebibmacro{textcite}}
  {}
  % {\usebibmacro{cite:dump}%
  %  \usebibmacro{postnote}%
  %  \ifbool{cbx:parens}
  %    {\bibclosebracket\global\boolfalse{cbx:parens}}
  %    {}}
  {\printtext[textcitesuperscript]{\usebibmacro{cite:dump}%
     \ifbool{cbx:parens}
       {\bibclosebracket\global\boolfalse{cbx:parens}}
       {}}%
   \iffieldundef{postnote}
     {}
     {\printtext[superscript]{\usebibmacro{postnote}}}}

\providerobustcmd*{\citet}{%
  \@ifstar
    {\AtNextCite{\AtEachCitekey{\defcounter{maxnames}{999}}}%
     \textcite}
    {\textcite}}

\providerobustcmd*{\citep}{%
  \@ifstar
    {\AtNextCite{\AtEachCitekey{\defcounter{maxnames}{999}}}%
     \cite}
    {\cite}}
