}

\cs_if_exist:NTF \prop_new_linked:N
  { \prop_new_linked:N \l__gbt_pinyin_prop }
  { \prop_new:N \l__gbt_pinyin_prop }

\clist_map_inline:Nn \l_tmpa_clist
  { \prop_put:Nnn \l__gbt_pinyin_prop {#1} { true } }

