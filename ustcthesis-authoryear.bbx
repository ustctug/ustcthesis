  \usebibmacro{fulldate}%
  \newunit}

\newbibmacro*{pages}{%
  \setunit*{\bibpagespunct}%
  \printfield{pages}}

\newbibmacro*{url+pid}{%
  \newunit\newblock
  \iftoggle{bbx:url}
    {\usebibmacro{url}}
    {}%
  \newunit\newblock
  \iftoggle{bbx:doi}
    {\iffieldundef{cstr}
       {\printfield{doi}}
       {\printfield{cstr}}}
    {}}

\renewbibmacro*{date+extradate}{%
  \iffieldundef{labelyear}
    {}
    % {\printtext[parens]{%
    {\iffieldequalstr{labeldatesource}{url}
       {\printtext[brackets]{%
          \iflabeldateisdate
            {\printdateextra}
            {\printlabeldateextra}}}
       {\iflabeldateisdate
          {\printdateextra}
          {\printlabeldateextra}}}}%

\DeclareNameAlias{author}{default}
\DeclareNameAlias{editor}{default}
\DeclareNameAlias{translator}{default}

\DeclareNameWrapperAlias{author}{default}
\DeclareNameWrapperAlias{editor}{default}
\DeclareNameWrapperAlias{translator}{default}

\renewbibmacro*{author}{%
  \ifboolexpr{
    test \ifuseauthor
    and
    not test {\ifnameundef{author}}
  }
    {\usebibmacro{bbx:dashcheck}
       {\bibnamedash}
       {\usebibmacro{bbx:savehash}%
        \printnames{author}%
        % \iffieldundef{authortype}
        %   {\setunit{\printdelim{nameyeardelim}}}
        %   {\setunit{\printdelim{authortypedelim}}}}%
    %  \iffieldundef{authortype}
    %    {}
    %    {\usebibmacro{authorstrg}%
    %     \setunit{\printdelim{nameyeardelim}}}}%
     \setunit{\printdelim{nameyeardelim}}}}%
    {\global\undef\bbx@lasthash
     % \usebibmacro{labeltitle}%
     \printtext{%
        \iffieldequalstr{langid}{chinese}
          {佚名}
          {Anon}}%
     \setunit*{\printdelim{nonameyeardelim}}}%
  \usebibmacro{date+extradate}}

\renewbibmacro*{editor}{%
  \usebibmacro{bbx:editor}{editorstrg}}
\renewbibmacro*{bbx:editor}[1]{%
  \ifboolexpr{
    test \ifuseeditor
    and
    not test {\ifnameundef{editor}}
  }
    {\usebibmacro{bbx:dashcheck}
       {\bibnamedash}
       {\printnames{editor}%
        % \setunit{\printdelim{editortypedelim}}%
        % \usebibmacro{bbx:savehash}}%
       }%
     % \usebibmacro{#1}%
     \clearname{editor}%
     \setunit{\printdelim{nameyeardelim}}}%
    {\global\undef\bbx@lasthash
     % \usebibmacro{labeltitle}%
     \printtext{%
        \iffieldequalstr{langid}{chinese}
          {佚名}
          {Anon}}%
     \setunit*{\printdelim{nonameyeardelim}}}%
  \usebibmacro{date+extradate}}


\DefineBibliographyExtras{english}{
  \protected\def\bibrangedash{%
    -\penalty\hyphenpenalty}% breakable dash
  \def\finalandcomma{\iftoggle{bbx:punctGB}{\addfullcomma}{\addcomma}}%
}

\DefineBibliographyStrings{english}{
  volume           = {v\adddot},
  version          = {V},
}

\ExplSyntaxOn


\NewDocumentCommand \ifbibnamepinyin { m m m m }
  {
    \__gbt_if_pinyin_name:nnnnTF {#1} {#2} {#3} {#4}
      { \@firstoftwo }
      { \@secondoftwo }
  }

\prg_new_protected_conditional:Npnn \__gbt_if_pinyin_name:nnnn #1#2#3#4 { TF }
  {
    \exp_args:Ne \str_if_empty:nTF { #3 #4 }
      {
        \__gbt_if_pinyin_family_name:nTF {#1}
          {
            % Given name
            \__gbt_if_pinyin_words:nTF {#2}
              { \prg_return_true: }
              {
                \__gbt_if_pinyin_words_with_delim:nnTF {#2} { ' }
                  { \prg_return_true: }
                  { \prg_return_false: }
              }
          }
          { \prg_return_false: }
      }
      { \prg_return_false: }
  }

\prg_new_protected_conditional:Npnn \__gbt_if_pinyin_family_name:n #1 { TF }
  {
    \__gbt_if_pinyin_words:nTF {#1}
      { \prg_return_true: }
      {
        \__gbt_if_pinyin_words_with_delim:nnTF {#1} { - }
          { \prg_return_true: }
          { \prg_return_false: }
      }
  }

\tl_new:N \l_gbt_pinyin_inits_tl

\prg_new_protected_conditional:Npnn \__gbt_if_pinyin_words:n #1 { TF }
  {
    \str_set:Ne \l_tmpa_str { \str_lowercase:f {#1} }
    \bool_set_false:N \l_tmpa_bool
    \int_step_inline:nn { \str_count:N \l_tmpa_str }
      {
        \str_set:Ne \l_tmpb_str { \str_range:Nnn \l_tmpa_str { 1 } { ##1 - 1 } }
        \tl_set:Nn \l_gbt_pinyin_inits_tl { }
        \str_if_empty:NF \l_tmpb_str
          {
            \tl_set:Ne \l_gbt_pinyin_inits_tl
              { \str_uppercase:f { \str_head:N \l_tmpa_str } }
            \tl_put_right:Nn \l_gbt_pinyin_inits_tl { \bibinitperiod }
          }
        \bool_lazy_or:nnT
          { \str_if_empty_p:N \l_tmpb_str }
          { \prop_if_in_p:NV \l__gbt_pinyin_prop \l_tmpb_str }
          {
            \str_set:Ne \l_tmpb_str
              { \str_range:Nnn \l_tmpa_str { ##1 } { - 1 } }
            \prop_if_in:NVT \l__gbt_pinyin_prop \l_tmpb_str
              {
                \bool_set_true:N \l_tmpa_bool
                \str_if_empty:NF \l_gbt_pinyin_inits_tl
                  { \tl_put_right:Nn \l_gbt_pinyin_inits_tl { \bibinitdelim } }
                \tl_put_right:Ne \l_gbt_pinyin_inits_tl
                  { \str_uppercase:f { \str_head:N \l_tmpb_str } }
                \tl_put_right:Nn \l_gbt_pinyin_inits_tl { \bibinitperiod }
                \prg_break:
              }
          }
      }
    \bool_if:NTF \l_tmpa_bool
      { \prg_return_true: }
      {
        \tl_clear:N \l_gbt_pinyin_inits_tl
        \prg_return_false:
      }
  }

\prg_new_protected_conditional:Npnn \__gbt_if_pinyin_words_with_delim:nn #1#2
  { TF }
  {
    \str_set:Ne \l_tmpa_str { \str_lowercase:f {#1} }
    \str_replace_all:Nnn \l_tmpa_str { ’ } { ' }
    \bool_set_false:N \l_tmpa_bool
    \str_if_in:NnT \l_tmpa_str { #2 }
      {
        \int_set:Nn \l_tmpa_int { 1 }
        \str_map_inline:Nn \l_tmpa_str
          {
            \str_if_eq:nnTF {##1} { #2 }
              { \str_map_break: }
              { \int_incr:N \l_tmpa_int }
          }
        \str_set:Ne \l_tmpb_str
          { \str_range:Nnn \l_tmpa_str { 1 } { \l_tmpa_int - 1 } }
        \prop_if_in:NVT \l__gbt_pinyin_prop \l_tmpb_str
          {
            \tl_set:Ne \l_gbt_pinyin_inits_tl
              { \str_uppercase:f { \str_head:N \l_tmpb_str } }
            \tl_put_right:Nn \l_gbt_pinyin_inits_tl { \bibinitperiod }
            \str_set:Ne \l_tmpb_str
              { \str_range:Nnn \l_tmpa_str { \l_tmpa_int + 1 } { - 1 } }
            \prop_if_in:NVT \l__gbt_pinyin_prop \l_tmpb_str
              {
                \bool_set_true:N \l_tmpa_bool
                \tl_put_right:Nn \l_gbt_pinyin_inits_tl { \bibinitdelim }
                \tl_put_right:Ne \l_gbt_pinyin_inits_tl
                  { \str_uppercase:f { \str_head:N \l_tmpb_str } }
                \tl_put_right:Nn \l_gbt_pinyin_inits_tl { \bibinitperiod }
              }
          }
      }
    \bool_if:NTF \l_tmpa_bool
      { \prg_return_true: }
      {
        \tl_clear:N \l_gbt_pinyin_inits_tl
        \prg_return_false:
      }
  }

