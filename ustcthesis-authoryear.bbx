\renewbibmacro*{maintitle+title}{%
  \iffieldsequal{maintitle}{title}
    {\clearfield{maintitle}%
     \clearfield{mainsubtitle}%
     \clearfield{maintitleaddon}}
    {\iffieldundef{maintitle}
       {}
       {\usebibmacro{maintitle}%
        \setunit{\addcolonspace}%
        \ifboolexpr{
          test {\iffieldundef{volume}}
          and
          test {\iffieldundef{part}}
        }
          {}
          {% 中国科学技术史：第2卷 科学思想史
           \printfield{volume}%
           \printfield{part}%
           \setunit{\quad}}}}%
  \usebibmacro{title}%
  \newunit}

\renewbibmacro*{maintitle+booktitle}{%
  \iffieldundef{maintitle}
    {}
    {\usebibmacro{maintitle}%
     \newunit\newblock
     \setunit{\addcolonspace}%
     \ifboolexpr{
       test {\iffieldundef{volume}}
       and
       test {\iffieldundef{part}}
     }
       {}
       {% 中国科学技术史：第2卷 科学思想史
         \printfield{volume}%
         \printfield{part}%
         \setunit{\quad}}}%
  \usebibmacro{booktitle}%
  \newunit}

\newbibmacro*{journal+volume+issue+pages}{%
  \usebibmacro{journal}%
  \setunit*{\addcommaspace}%
  \iffieldequalstr{entrysubtype}{newspaper}
    {\usebibmacro{fulldate}%
     \setunit*{}%
     \printfield[parens]{pages}}
    {\ifboolexpr{
       test {\iffieldundef{volume}}
       and
       test {\iffieldundef{number}}
     }
       {% 在线出版日期
        \usebibmacro{fulldate}}
       {\usebibmacro{date}%
        \iffieldundef{volume}
          {}
          {\setunit*{\addcommaspace}%
           \printfield{volume}}%
        \iffieldundef{number}
          {}
          {\setunit*{}%
           \printfield[parens]{number}}}%
     \iffieldundef{pages}
       {\setunit*{\bibeidpunct}%
        \printfield{eid}}
       {\setunit*{\bibpagespunct}%
        \printfield{pages}}}%
  \newunit}

\renewbibmacro*{publisher+location+date}{%
  \printlist{location}%
  \iflistundef{publisher}
    {\setunit*{\addcommaspace}}
    {\setunit*{\addcolonspace}}%
  \printlist{publisher}%
  \setunit*{\addcommaspace}%
  \usebibmacro{date}%
  \newunit}

