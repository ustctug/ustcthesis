\ProvidesFile{ustcthesis-authoryear.bbx}[2025-07-01 v5.0.0 GB/T 7714 author-year bibliography style (USTC variant)]

\RequireBiber[3]

\RequireBibliographyStyle{authoryear}

\AtBeginBibliography{%
  \urlstyle{same}%
}

\newtoggle{bbx:punctGB}
\DeclareBibliographyOption[string]{bibpunct}[GB]{%
  \ifcsdef{blx@opt@bib@punct@#1}
    {\csuse{blx@opt@bib@punct@#1}}
    {\blx@err@invopt{bibpunct=#1}{}}}

\def\blx@opt@bib@punct@GB{\toggletrue{bbx:punctGB}}
\def\blx@opt@bib@punct@half{\togglefalse{bbx:punctGB}}

\ExecuteBibliographyOptions{
  sorting     = GB,
  sortlocale  = zh__pinyin,
  maxbibnames = 3,
  minbibnames = 3,
  date        = year,
  urldate     = iso,
  seconds     = true,
  url         = false,
  doi         = false,
  dashed      = false,
  giveninits  = true,
  bibpunct    = half,
}

\newrobustcmd*{\addfullcomma}{，}
\newrobustcmd*{\addcommaspace}{\iftoggle{bbx:punctGB}{\addfullcomma}{\addcomma\space}}
\newrobustcmd*{\addcomma@bibnamedelimd}
  {\iftoggle{bbx:punctGB}{\addfullcomma\penalty\value{lownamepenalty}}{\addcomma\bibnamedelimd}}

\newrobustcmd*{\addfullcolon}{\iftoggle{bbx:punctGB}{：}{\addcolon}}
\newrobustcmd*{\addcolonspace}{\iftoggle{bbx:punctGB}{：}{\addcolon\space}}

\newrobustcmd*{\addfullsemicolon}{\iftoggle{bbx:punctGB}{；}{\addsemicolon}}
\newrobustcmd*{\addsemicolonspace}{\iftoggle{bbx:punctGB}{；}{\addsemicolon\space}}

\newrobustcmd*{\addfullexclam}{\iftoggle{bbx:punctGB}{！}{\addexclam}}
\newrobustcmd*{\addexclamspace}{\iftoggle{bbx:punctGB}{！}{\addexclam\space}}

\newrobustcmd*{\addfullquestion}{\iftoggle{bbx:punctGB}{？}{\addquestion}}
\newrobustcmd*{\addquestionspace}{\iftoggle{bbx:punctGB}{？}{\addquestion\space}}

\newrobustcmd*{\adddoubleslash}{%
  \unspace//\penalty\hyphenpenalty\hskip\z@skip}

\newrobustcmd*{\addhalfspace}{%
  \iftoggle{bbx:punctGB}{}{\addspace}}

\renewrobustcmd*{\bibinitperiod}{}
\renewrobustcmd*{\bibinithyphendelim}{\mbox{-}}

\renewrobustcmd*{\bibdaterangesep}{\iftoggle{bbx:punctGB}{—}{\hyphen}\penalty\hyphenpenalty}

\renewrobustcmd*{\bibrangedash}{-}

\renewcommand*{\bibleftparen}{\blx@postpunct\iftoggle{bbx:punctGB}{\unspace （}{(}}
\renewcommand*{\bibrightparen}{\blx@postpunct\iftoggle{bbx:punctGB}{）}{)}\midsentence}
\newcommand*{\addrightparenspace}{\blx@postpunct\iftoggle{bbx:punctGB}{）}{)\space}\midsentence}

\DeclareDatamodelEntrytypes{
  archive,
  map,
  preprint}

\DeclareDatamodelFields[type=field, datatype=literal]{
  % 用于语言
  sortlang,
  % 专利的申请号
  applicationnumber,
  % 地图的尺寸
  dimensions,
  % 地图的比例尺
  scale,
  % 文献类型标识
  entrytypeid,
  % 文献载体标识
  entrymediumid}

\DeclareDatamodelFields[type=field, datatype=verbatim]{
  % 科技资源标识服务平台（Common Science and Technology Resources, CSTR）
  cstr}

\DeclareStyleSourcemap{
  \maps{
    % 默认 \DeclareDriverSourcemap 中的内容放在前面
    \map{
      \step[typesource=conference, typetarget=inproceedings]
      \step[typesource=electronic, typetarget=online]
      \step[typesource=www,        typetarget=online]
    }
    \map{
      \step[typesource=mastersthesis, typetarget=thesis, final]
      \step[fieldset=type,            fieldvalue=mathesis]
    }
    \map{
      \step[typesource=phdthesis, typetarget=thesis, final]
      \step[fieldset=type,        fieldvalue=phdthesis]
    }
    \map{
      \step[typesource=techreport, typetarget=report, final]
      \step[fieldset=type,         fieldvalue=techreport]
    }
    \map{
      \step[fieldsource=hyphenation,   fieldtarget=langid]
      \step[fieldsource=address,       fieldtarget=location]
      \step[fieldsource=school,        fieldtarget=institution]
      \step[fieldsource=annote,        fieldtarget=annotation]
      \step[fieldsource=archiveprefix, fieldtarget=eprinttype]
      \step[fieldsource=journal,       fieldtarget=journaltitle]
      \step[fieldsource=primaryclass,  fieldtarget=eprintclass]
      \step[fieldsource=key,           fieldtarget=sortkey]
      \step[fieldsource=pdf,           fieldtarget=file]
    }
    %
    % 设置语言
    \map[foreach={title, booktitle, journaltitle, maintitle}]{
      \step[notfield=langid, final]
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{[\x{4e00}-\x{9fff}]}, final]
      \step[fieldset=langid, fieldvalue=chinese]
    }
    \map{
      \step[fieldsource=langid, match=\regexp{^(.+)$}, replace=\regexp{\L$1}, final]
    }
    \map{
      \step[fieldset=langid, fieldvalue=english]
    }
    %
    % 将 biblatex 的文献类型整理为 GB/T 7714 定义的文献类型
    \map{
      \step[typesource=booklet, typetarget=book]
      \step[typesource=image, typetarget=misc]
      \step[typesource=jurisdiction, typetarget=archive]
      \step[typesource=legal, typetarget=archive]
      \step[typesource=legislation, typetarget=archive]
      \step[typesource=letter, typetarget=archive]
      \step[typesource=manual, typetarget=report]
      \step[typesource=unpublished, typetarget=misc]
      \step[typesource=video, typetarget=misc]
    }
    %
    % 处理 howpublished 的 URL
    \map{
      \step[fieldsource=howpublished, match=\regexp{^\\url\{([^\}]+)\}$}, final]
      \step[fieldset=url, fieldvalue={$1}]
      \step[fieldset=howpublished, null]
    }
    %
    % 处理预印本
    \map{
      \pertype{article}
      \step[notfield=journaltitle, final]
      \step[fieldsource=eprint, final]
      \step[typesource=article, typetarget=preprint]
    }
    \map{
      \pertype{article}
      \step[fieldsource=journaltitle, matchi={arXiv}, final]
      \step[typesource=article, typetarget=preprint]
    }
    \map{
      \step[fieldsource=eprint, final]
      \step[typesource=misc, typetarget=preprint]
      \step[typesource=online, typetarget=preprint]
    }
    %
    % 处理含有 URL 的 @misc
    \map{
      \step[fieldsource=url, final]
      \step[typesource=misc, typetarget=online]
    }
    %
    % 补充文献类型标识 entrytypeid
    \map{
      \pertype{archive}
      \step[fieldset=entrytypeid, fieldvalue=A]
    }
    \map{
      \pertype{article}
      \step[fieldsource=entrysubtype, match=\regexp{(^(.+)$)}, replace=\regexp{\L$1}, final]
      \step[fieldsource=entrysubtype, match=\regexp{newspaper}, final]
      \step[fieldset=entrytypeid, fieldvalue=N]
    }
    \map[overwrite]{
      \step[typesource=newspaper, typetarget=article, final]
      \step[fieldset=entrysubtype, fieldvalue=newspaper]
      \step[fieldset=entrytypeid, fieldvalue=N]
    }
    \map{
      \pertype{article}
      \step[fieldset=entrytypeid, fieldvalue=J]
    }
    \map{
      \pertype{book}
      \step[fieldset=entrytypeid, fieldvalue=M]
    }
    % \map{
    %   \pertype{bookinbook}
    %   \step[typesource=bookinbook, typetarget=book, final]
    %   \step[fieldset=entrytypeid, fieldvalue=M]
    % }
    \map{
      \pertype{collection}
      \step[typesource=collection, typetarget=book, final]
      \step[fieldset=entrytypeid, fieldvalue=G]
    }
    \map{
      \pertype{dataset}
      \step[fieldset=entrytypeid, fieldvalue=DS]
    }
    \map{
      \pertype{inbook}
      \step[fieldset=entrytypeid, fieldvalue=M]
    }
    \map{
      \pertype{incollection}
      \step[fieldset=entrytypeid, fieldvalue=M]
    }
    \map{
      \pertype{inproceedings}
      \step[fieldset=entrytypeid, fieldvalue=C]
    }
    % \map{
    %   \pertype{inreference}
    %   \step[typesource=inreference, typetarget=incollection, final]
    %   \step[fieldset=entrytypeid, fieldvalue=M]
    % }
    \map{
      \pertype{map}
      \step[fieldset=entrytypeid, fieldvalue=CM]
      \step[fieldsource=booktitle, final]
      \step[typesource=map, typetarget=incollection]
    }
    % \map{
    %   \pertype{mvcollection}
    %   \step[typesource=mvcollection, typetarget=book, final]
    %   \step[fieldset=entrytypeid, fieldvalue=G]
    % }
    % \map{
    %   \pertype{mvreference}
    %   \step[typesource=mvreference, typetarget=book, final]
    %   \step[fieldset=entrytypeid, fieldvalue=M]
    % }
    % \map{
    %   \pertype{mvproceedings}
    %   \step[typesource=mvproceedings, typetarget=collection, final]
    %   \step[fieldset=entrytypeid, fieldvalue=C]
    % }
    % \map{
    %   \pertype{mvbook}
    %   \step[typesource=mvbook, typetarget=book, final]
    %   \step[fieldset=entrytypeid, fieldvalue=M]
    % }
    \map{
      \pertype{online}
      \step[fieldset=entrytypeid, fieldvalue=EB]
    }
    \map{
      \pertype{patent}
      \step[fieldset=entrytypeid, fieldvalue=P]
    }
    \map{
      \pertype{periodical}
      \step[fieldset=entrytypeid, fieldvalue=J]
    }
    \map{
      \pertype{preprint}
      \step[fieldset=entrytypeid, fieldvalue=PP]
    }
    \map{
      \pertype{proceedings}
      \step[typesource=proceedings, typetarget=book]
      \step[fieldset=entrytypeid, fieldvalue=C]
    }
    % \map{
    %   \pertype{reference}
    %   \step[typesource=reference, typetarget=book, final]
    %   \step[fieldset=entrytypeid, fieldvalue=M]
    % }
    \map{
      \pertype{report}
      \step[fieldset=entrytypeid, fieldvalue=R]
    }
    \map{
      \pertype{software}
      \step[fieldset=entrytypeid, fieldvalue=CP]
      \step[fieldsource=url, final]
      \step[typesource=software, typetarget=online]
    }
    \map{
      \pertype{standard}
      \step[fieldset=entrytypeid, fieldvalue=S]
    }
    % \map{
    %   \pertype{suppbook}
    %   \step[typesource=suppbook, typetarget=book, final]
    %   \step[fieldset=entrytypeid, fieldvalue=M]
    % }
    % \map{
    %   \pertype{suppcollection}
    %   \step[typesource=suppcollection, typetarget=book, final]
    %   \step[fieldset=entrytypeid, fieldvalue=M]
    % }
    % \map{
    %   \pertype{suppperiodical}
    %   \step[typesource=suppperiodical, typetarget=book, final]
    %   \step[fieldset=entrytypeid, fieldvalue=J]
    % }
    \map{
      \pertype{thesis}
      \step[fieldset=entrytypeid, fieldvalue=D]
    }
    \map{
      \step[notfield=entrytypeid, final]
      \step[fieldsource=URL, final]
      \step[fieldset=entrytypeid, fieldvalue=EB]
    }
    \map{
      \step[fieldset=entrytypeid, fieldvalue=Z]
    }
    %
    % 处理文献载体标识
    % 兼容 `medium`
    \map{
      \step[fieldsource=medium, match=\regexp{^([A-Z][A-Z])$}, final]
      \step[fieldset=entrymediumid, fieldvalue={$1}]
      \step[fieldset=medium, null]
    }
    %
    % 专利优先使用申请者/所有者
    \map[overwrite]{
      \pertype{patent}
      \step[fieldsource=holder, final]
      \step[fieldset=author, origfieldval]
      \step[fieldset=holder, null]
    }
    %
    % 兼容拆分后的姓名格式：`张, 三`
    \map[foreach={author, editor, translator}]{
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{([\x{4e00}-\x{9fff}]),\s*([\x{4e00}-\x{9fff}])}, replace=\regexp{$1$2}]
    }
    %
    % 处理用语排序的s
    % 各篇文献应首先按文种集中，可分为中文、日文、西文、俄文、其他文种 5 部分
    \map{
      \step[fieldsource=langid, match={chinese}, final]
      \step[fieldset=sortlang, fieldvalue={1}]
    }
    \map{
      \step[fieldsource=langid, match={japanese}, final]
      \step[fieldset=sortlang, fieldvalue={2}]
    }
    \map{
      \step[fieldsource=langid, match={french}, final]
      \step[fieldset=sortlang, fieldvalue={3}]
    }
    \map{
      \step[fieldsource=langid, match={german}, final]
      \step[fieldset=sortlang, fieldvalue={3}]
    }
    \map{
      \step[fieldsource=langid, match={italian}, final]
      \step[fieldset=sortlang, fieldvalue={3}]
    }
    \map{
      \step[fieldsource=langid, match={portuguese}, final]
      \step[fieldset=sortlang, fieldvalue={3}]
    }
    \map{
      \step[fieldsource=langid, match={spanish}, final]
      \step[fieldset=sortlang, fieldvalue={3}]
    }
    \map{
      \step[fieldsource=langid, match={russian}, final]
      \step[fieldset=sortlang, fieldvalue={4}]
    }
    \map{
      \step[fieldset=sortlang, fieldvalue={5}]
    }
    %
    % 处理用语排序的年份
    \map{
      \step[fieldsource=year, match=\regexp{^c(\d+)$}, final]
      \step[fieldset=sortyear, fieldvalue={$1}]
    }
    \map{
      \step[fieldsource=year, match=\regexp{^(\d+)\s*(\(.+\)|（.+）|印刷)$}, final]
      \step[fieldset=sortyear, fieldvalue={$1}]
    }
    %
    % 专利优先使用申请号
    \map[overwrite]{
      \pertype{patent}
      \step[fieldsource=applicationnumber, final]
      \step[fieldset=number, origfieldval]
      \step[fieldset=applicationnumber, null]
    }
    %
    % 地图的尺寸
    \map{
      \pertype{map}
      \step[fieldsource=dimensions, match=\regexp{(\d+[A-Za-z]]+)x(\d+[A-Za-z]+)}, replace=\regexp{$1×$2}]
      \step[fieldsource=dimensions, match=\regexp{(\d+)([A-Za-z]+)}, replace=\regexp{$1\\,$2}]
    }
    %
    % 连续出版物的年份、年卷期
    \map{
      \pertype{periodical}
      \step[fieldsource=volume, match=\regexp{-+}, replace=\regexp{\\bibdaterangesep\x20}]
      \step[fieldsource=volume, match=\regexp{–}, replace=\regexp{\\bibdaterangesep\x20}]
      \step[fieldsource=volume, match=\regexp{—}, replace=\regexp{\\bibdaterangesep\x20}]
    }
    % 检查 CSTR 和 DOI 是否包含在 URL 中，若包含则删除 CSTR 和 DOI 字段
    \map{
      \step[fieldsource=cstr, match=\regexp{(.+)}, final]
      \step[fieldsource=url, match=\regexp{$1}, final]
      \step[fieldset=cstr, null]
    }
    \map{
      \step[fieldsource=doi, match=\regexp{(.+)}, final]
      \step[fieldsource=url, match=\regexp{$1}, final]
      \step[fieldset=doi, null]
    }
    %
    % 处理标题内的全角/半角标点
    \map[overwrite, foreach={author, title, translator, editor, subtitle, volume, booktitle, journaltitle, eventtitle, location, publisher, institution, year, pages}]{
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{\(}, replace=\regexp{\\bibleftparen\x20}]
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{（}, replace=\regexp{\\addspace\\bibleftparen\x20}]
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{(\)|）)([,.:;?!—–-，。：；？！])}, replace=\regexp{\\bibrightparen\x20$2}]
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{(\)\s+|）)}, replace=\regexp{\\addrightparenspace\x20}]
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{\)}, replace=\regexp{\\bibrightparen\x20}]
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{，}, replace=\regexp{\\addcommaspace\x20}]
      % \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{．}, replace={\adddotspace\x20}]
      % \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{;\s*}, replace={；}]
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{(:\s+|：)}, replace=\regexp{\\addcolonspace\x20}]
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{:}, replace=\regexp{\\addfullcolon\x20}]
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{(;\s+|；)}, replace=\regexp{\\addsemicolonspace\x20}]
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{;}, replace=\regexp{\\addfullsemicolon\x20}]
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{(!\s+|！)}, replace=\regexp{\\addexclamspace\x20}]
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{!}, replace=\regexp{\\addfullexclam\x20}]
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{(\?\s+|？)}, replace=\regexp{\\addquestionspace\x20}]
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{\?}, replace=\regexp{\\addfullquestion\x20}]
    }
    \map[overwrite, foreach={title, subtitle, volume, booktitle, journaltitle, eventtitle, location, publisher, institution, year, pages}]{
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{,\s+}, replace=\regexp{\\addcommaspace\x20}]
      \step[fieldsource=\regexp{$MAPLOOP}, match=\regexp{,}, replace=\regexp{\\addcomma\x20}]
    }
    %
    % 中、西文混用的标点（兼容 xeCJK）
    \map[overwrite, foreach={author, title, subtitle, volume, translator, editor, booktitle, journaltitle, eventtitle, location, publisher, institution}]{
      \step[fieldsource=langid, notmatch=\regexp{^(chinese|japanese|korean)}, final]
      \step[fieldsource=\regexp{$MAPLOOP}, match={–}, replace={--}]
      \step[fieldsource=\regexp{$MAPLOOP}, match={—}, replace={---}]
      \step[fieldsource=\regexp{$MAPLOOP}, match={‘}, replace={`}]
      \step[fieldsource=\regexp{$MAPLOOP}, match={’}, replace={'}]
      \step[fieldsource=\regexp{$MAPLOOP}, match={“}, replace={``}]
      \step[fieldsource=\regexp{$MAPLOOP}, match={”}, replace={''}]
    }
    %
  }
}

\DeclareDelimFormat{multinamedelim}{\addcommaspace}
\DeclareDelimFormat[bib,biblist]{finalnamedelim}{%
  % \ifnumgreater{\value{liststop}}{2}{\finalandcomma}{}%
  % \addspace\bibstring{and}\space}
  \printdelim{multinamedelim}}

\DeclareDelimFormat[bib,biblist]{andothersdelim}{%
  \iftoggle{bbx:punctGB}
    {}
    {\addspace}}

\DeclareDelimFormat{translatortypedelim}{\addcommaspace}

\DeclareDelimFormat[bib,biblist]{nameyeardelim}{\addcommaspace}
\DeclareDelimFormat[bib,biblist]{nonameyeardelim}{\addcommaspace}

\renewcommand*{\subtitlepunct}{\addcolonspace}
\renewcommand*{\bibpagespunct}{\addcolonspace}

\renewcommand*{\bibeidpunct}{\addcolonspace}

\renewcommand*{\revsdnamepunct}{}

\setcounter{biburllcpenalty}{250}
\setcounter{biburlucpenalty}{250}
\setcounter{biburlnumpenalty}{250}

\DeclareFieldFormat{doi}{%
  DOI\addcolon\allowbreak
  \ifhyperref
    {\href{https://doi.org/#1}{\nolinkurl{#1}}}
    {\nolinkurl{#1}}}

\DeclareFieldFormat{cstr}{%
  CSTR\addcolon\allowbreak
  \ifhyperref
    {\href{https://www.cstr.cn/CSTR:#1}{\nolinkurl{#1}}}
    {\nolinkurl{#1}}}

\DeclareFieldFormat{edition}{%
  \ifinteger{#1}
    {\iffieldequalstr{langid}{chinese}
       {#1 版}
       {\mkbibordedition{#1}~\bibstring{edition}}}
    {#1\isdot}}

\DeclareFieldFormat{journaltitle}{#1\isdot}
\DeclareFieldFormat{issuetitle}{#1}
\DeclareFieldFormat{maintitle}{#1}
\DeclareFieldFormat{booktitle}{#1}

\DeclareFieldFormat{pages}{#1}

\DeclareFieldFormat*{title}{#1}

\DeclareFieldFormat{url}{\url{#1}}
\DeclareFieldFormat{urldate}{\mkbibbrackets{#1}}
\DeclareFieldFormat{version}{\bibstring{version}#1}
\DeclareFieldFormat{volume}{%
  \ifboolexpr{
    test {\iffieldnum{volume}}
    or
    test {\iffieldnums{volume}}
  }
    {\iffieldequalstr{langid}{chinese}
       {第~#1 卷}
       {\bibstring{volume}~#1}}
    {#1\isdot}}
\DeclareFieldFormat[article,periodical]{volume}{#1}% volume of a journal

\DeclareFieldFormat{titlecase}{\MakeSentenceCase*{#1}}
\DeclareFieldAlias{titlecase:title}{titlecase}
\DeclareFieldAlias{titlecase:booktitle}{titlecase}
\DeclareFieldFormat{titlecase:journaltitle}{#1}
\DeclareFieldAlias[periodical]{titlecase:title}{titlecase:journaltitle}

\newcommand*{\bbx@colon@search}[2]{%
  \bbx@colon@search@auxi\empty#2: \stop{#1}%
}
\long\def\bbx@colon@search@auxi#1: #2\stop#3{%
  \expandafter\bbx@colon@search@auxii\expandafter{#1}{#3}%
  \ifblank{#2}
    {}
    {%
      : %
      \bbx@colon@search@auxi\empty#2\stop{#3}%
    }%
}
\newcommand\bbx@colon@search@auxii[2]{#2{#1}}

\DeclareNameFormat{family-given}{%
  \ifgiveninits
    {\ifbibnamepinyin{\namepartfamily}{\namepartgiven}{\namepartprefix}{\namepartsuffix}
       {\togglefalse{abx@bool@giveninits}%
        \letcs\namepartgiveni{l_gbt_pinyin_inits_tl}}
       {}}
    {}%
  \ifgiveninits
    {\usebibmacro{name:family-given}
      {\namepartfamily}
      {\namepartgiveni}
      {\namepartprefix}
      {\namepartsuffix}}
    {\usebibmacro{name:family-given}
      {\namepartfamily}
      {\namepartgiven}
      {\namepartprefix}
      {\namepartsuffix}}%
  \usebibmacro{name:andothers}}

\DeclareNameAlias{default}{family-given}

\renewbibmacro*{name:family-given}[4]{%
  \ifuseprefix
    {\usebibmacro{name:delim}{#3#1}%
     \usebibmacro{name:hook}{#3#1}%
     \mkbibcompletenamefamilygiven{%
       \ifdefvoid{#3}
         {}
         {\ifcapital
            {\mkbibnameprefix{\MakeCapital{#3}}\isdot}
            {\mkbibnameprefix{#3}\isdot}%
          \ifprefchar{}{\bibnamedelimc}}%
       \mkbibnamefamily{#1}\isdot
      %  \ifdefvoid{#4}
      %    {}
      %    {\bibnamedelimd\mkbibnamesuffix{#4}\isdot}%
      %  \ifdefvoid{#2}
      %    {}
      %    {\revsdnamepunct\bibnamedelimd\mkbibnamegiven{#2}\isdot}}}
       \ifdefvoid{#2}
         {}
         {\revsdnamepunct\bibnamedelimd\mkbibnamegiven{#2}\isdot}%
       \ifdefvoid{#4}
         {}
         {\addcomma@bibnamedelimd\mkbibnamesuffix{#4}\isdot}}}
    {\usebibmacro{name:delim}{#1}%
     \usebibmacro{name:hook}{#1}%
     \mkbibcompletenamefamilygiven{%
       \mkbibnamefamily{#1}\isdot
       \ifboolexpe{%
         test {\ifdefvoid{#2}}
         and
         test {\ifdefvoid{#3}}}
         {}
         {\revsdnamepunct}%
       \ifdefvoid{#2}
         {}
         {\bibnamedelimd\mkbibnamegiven{#2}\isdot}%
       \ifdefvoid{#3}
         {}
         {\bibnamedelimd\mkbibnameprefix{#3}\isdot}}%
       \ifdefvoid{#4}
         {}
         {\addcomma@bibnamedelimd\mkbibnamesuffix{#4}\isdot}}}

\renewbibmacro*{name:andothers}{%
  \ifboolexpr{
    test {\ifnumequal{\value{listcount}}{\value{liststop}}}
    and
    test \ifmorenames
  }
    {%
     \ifnumgreater{\value{liststop}}{1}
       {\finalandcomma}
       {}%
     \printdelim{andothersdelim}%
     \iffieldequalstr{langid}{chinese}
       {等}
       {\bibstring{andothers}}}%
    {}}

\DeclareSortingTemplate{GB}{
  \sort{
    \field{sortlang}
  }
  \sort{
    \field{presort}
  }
  \sort[final]{
    \field{sortkey}
  }
  \sort{
    \field{sortname}
    \field{author}
    \field{editor}
    % \field{translator}
    % \field{sorttitle}
    % \field{title}
  }
  \sort{
    \field{sortyear}
    \field{year}
    \field{urlyear}
  }
  \sort{
    \field{sorttitle}
    \field{title}
  }
  \sort{
    \field{volume}
    \literal{0}
  }
}

\renewbibmacro*{editor}{%
  \ifboolexpr{
    test \ifuseeditor
    and
    not test {\ifnameundef{editor}}
  }
    {\printnames{editor}%
     % \setunit{\printdelim{editortypedelim}}%
     % \usebibmacro{editorstrg}%
     \clearname{editor}}
    {}}

\renewbibmacro*{translator}{%
  \ifnameundef{translator}
    {}
    {\printnames{translator}%
     \setunit{\printdelim{translatortypedelim}}%
     \usebibmacro{translatorstrg}%
     \clearname{translator}}}

\renewbibmacro*{translatorstrg}{%
  \printtext[translatortype]{%
    \iffieldequalstr{langid}{chinese}
      {译}
      {\ifboolexpr{
         test {\ifnumgreater{\value{translator}}{1}}
         or
         test {\ifandothers{translator}}
       }
         {\bibstring{translators}}
         {\bibstring{translator}}}}}

\newbibmacro*{in:editor}{%
  \ifnameundef{editor}
    {}
    {%
     % \usebibmacro{bytypestrg}{editor}{editor}%
     % \setunit{\addspace}%
     \printnames[byeditor]{editor}%
     \newunit}}
  % \usebibmacro{byeditorx}%

\renewbibmacro*{title}{%
  \ifboolexpr{
    test {\iffieldundef{title}}
    and
    test {\iffieldundef{subtitle}}
  }
    {}
    {\printtext[title]{%
       \printfield[titlecase:title]{title}%
       \setunit{\subtitlepunct}%
       \printfield[titlecase:title]{subtitle}}%
     \ifboolexpr{
       not test {\iffieldundef{volume}}
       and
       test {\iffieldundef{maintitle}}
       and
       test {\iffieldundef{booktitle}}
       and
       not test {\ifentrytype{article}}
       and
       not test {\ifentrytype{periodical}}
     }
       {\setunit{\subtitlepunct}%
        \printfield{volume}}
       {}%
     \ifboolexpr{
       test {\iffieldequalstr{entrytypeid}{R}}
       or
       test {\iffieldequalstr{entrytypeid}{P}}
       or
       test {\iffieldequalstr{entrytypeid}{A}}
       and
       not test {\iffieldundef{number}}
     }
       {\setunit*{\subtitlepunct}%
        \printfield{number}}
       {}%
     \ifboolexpr{
       test {\ifentrytype{map}}
       and
       not test {\iffieldundef{scale}}
     }
       {\newunit
        \printfield{scale}}
       {}%
     \setunit*{\addhpthinspace}%
     \usebibmacro{entrytypeid}}}

\newbibmacro*{entrytypeid}{%
  \printtext[brackets]{%
    \iffieldundef{entrytypeid}
      {\printtext{Z}}
      {\printfield{entrytypeid}}%
    \setunit{/}%  \addslash is breakable
    \iffieldundef{entrymediumid}
      {\ifboolexpr{
         (not test {\iffieldundef{url}}
          and
          test {\iftoggle{bbx:url}})
         or
         (not test {\iffieldundef{cstr}}
          or
          not test {\iffieldundef{doi}}
          and
          test {\iftoggle{bbx:doi}})
       }
         {\printtext{OL}}
         {}}
      {\printfield{entrymediumid}}}}

\renewbibmacro*{booktitle}{%
  \ifboolexpr{
    test {\iffieldundef{booktitle}}
    and
    test {\iffieldundef{booksubtitle}}
  }
    {}
    {\printtext[booktitle]{%
       \printfield[titlecase:booktitle]{booktitle}%
       \setunit{\subtitlepunct}%
       \printfield[titlecase:booktitle]{booksubtitle}}%
     \iffieldundef{maintitle}
       {\setunit{\addcolonspace}%
        \printfield{volume}%
        \printfield{part}}
       {}%
    \newunit}}

\renewbibmacro*{journal}{%
  \ifboolexpr{
    test {\iffieldundef{journaltitle}}
    and
    test {\iffieldundef{journalsubtitle}}
  }
    {}
    {\printtext[journaltitle]{%
       \printfield[titlecase:journaltitle]{journaltitle}%
       \setunit{\subtitlepunct}%
       \printfield[titlecase:journaltitle]{journalsubtitle}}%
     \newunit}}

\newbibmacro*{fulldate}{%
  \iflabeldateisdate
    {\mkdaterangeiso{}}
    {}%
}

