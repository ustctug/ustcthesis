\chapter{标题}
\clearpage

\TIMO
\begin{algorithm}
  \caption{欧几里得算法}
  \label{alg:euclid}
  \begin{algorithmic}
    \REQUIRE 两个非负整数 $a$ 和 $b$
    \ENSURE $a$ 和 $b$ 的最大公约数 $\gcd(a, b)$

    \WHILE{$b \neq 0$}
      \IF{$a > b$}
        \STATE $a \gets a - b$
      \ELSE
        \STATE $b \gets b - a$
      \ENDIF
    \ENDWHILE

    \RETURN $a$
  \end{algorithmic}
\end{algorithm}

\clearpage
\OMIT
